# Copy this file to .env and fill in your keys
# cp .env.example .env

# YouTube Data API v3 (FREE — get one at https://console.cloud.google.com/apis)
# Enable "YouTube Data API v3", then create an API key under Credentials
YOUTUBE_API_KEY=

# RapidAPI Key (for TikTok scraper — https://rapidapi.com)
# Subscribe to "TikTok Scraper" (tiktok-scraper7) on RapidAPI
RAPIDAPI_KEY=

# Instagram does NOT need an API key — it uses Instagram's public web API directly

# Anthropic Claude API (for AI-drafted reply suggestions on the Reply tab)
# Without this key the Reply tab falls back to deterministic rule-based drafts.
ANTHROPIC_API_KEY=
# Optional: override the model used for reply drafting
CLAUDE_MODEL=claude-sonnet-5

# Server port (default: 3000)
PORT=3000
